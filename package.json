{
  "name": "tarsi",
  "type": "module",
  "version": "0.1.0",
  "description": "An AI-powered CLI for generating user-focused changelogs directly from git changes, minimizing manual effort.",
  "author": "Luis Emidio",
  "license": "MIT",
  "homepage": "https://github.com/9aia/tarsi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9aia/tarsi.git"
  },
  "bugs": {
    "url": "https://github.com/9aia/tarsi/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "generation",
    "ai",
    "llm",
    "gemini",
    "changelog",
    "generator",
    "release notes",
    "automation",
    "git"
  ],
  "module": "src/main.ts",
  "bin": {
    "tarsi": "./dist/tarsi"
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "dist"
  ],
  "scripts": {
    "start": "bun .",
    "dev": "bun --watch .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/main.ts --outfile dist/tarsi --compile --minify --sourcemap",
    "release": "release-it",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@google/genai": "^1.6.0",
    "dedent": "^1.6.0",
    "semver": "^7.7.2",
    "simple-git": "^3.28.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.1",
    "@release-it/keep-a-changelog": "^7.0.0",
    "@types/node": "^24.3.0",
    "@types/semver": "^7.7.0",
    "eslint": "^9.33.0",
    "release-it": "^19.0.4",
    "typescript": "^5.9.2"
  }
}
